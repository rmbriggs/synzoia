# Public Supabase URL — same value as backend SUPABASE_URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key — safe to ship to the browser; RLS is the real gate.
# DO NOT put the service role key here; that lives in the backend.
VITE_SUPABASE_ANON_KEY=

# FastAPI base URL. Leave unset for production and `vercel dev` —
# the frontend's api/client.ts defaults to `/api` (same origin as
# the Vercel deployment, where /api/* routes to the Python function).
# Set this only if you're running the FastAPI server standalone
# on a different host/port for local debugging.
# VITE_API_BASE_URL=http://localhost:8000

# Dev-only: when set to "true", the frontend uses a localStorage-backed
# fake auth flow so you can navigate the app before real auth is wired.
# Leave unset (or any other value) in production. See
# docs/superpowers/specs/2026-05-19-frontend-dev-auth-bypass-design.md.
VITE_DEV_FAKE_AUTH=true
